# ------------------------------------------------------------------------------------------------
# Reelsmith settings. Copy to .env (setup.sh does this) - .env is git-ignored, keys stay on your Mac.
# ------------------------------------------------------------------------------------------------

# Which AI edits your reel: auto | gemini | ollama | claude | heuristic
#   auto = the first one that's ready, in order: Claude -> Gemini -> local Ollama -> built-in rules
# (You can also switch per reel in the app.)
LLM_PROVIDER=auto

# --- Google Gemini (e.g. Gemini 4 Hydrogen) ---------------------------------------------------
# Free API key: https://aistudio.google.com/apikey  (separate from the Gemini app subscription)
GEMINI_API_KEY=
# Any model name your key can use (e.g. a free-tier gemini-3.1-flash-lite), or empty to auto-detect
# (prefers gemini-4-hydrogen, then the newest Flash). Easier: set it in the app under ⚙ Settings.
GEMINI_MODEL=

# --- Local AI via Ollama (free, private, offline) ---------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# Vision model that logs every shot. 16 GB Mac: qwen3-vl:8b-instruct (6.2 GB). Faster: qwen3-vl:4b-instruct
OLLAMA_MODEL=qwen3-vl:8b-instruct
# Model that writes the edit (defaults to the same one, so nothing has to swap in memory).
# e.g. qwen3-vl:8b-thinking reasons more (slower).
OLLAMA_PLAN_MODEL=
# best = outline the story first, then write the edit (2 passes) | fast = one pass
OLLAMA_PLAN_DEPTH=best
# Context window for planning, and how many shots the local model logs per reel
OLLAMA_NUM_CTX=16384
LOCAL_MAX_SHOTS=30

# --- Anthropic Claude (optional) --------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Speech-to-text for captions: tiny | base | small | medium ---------------------------------
WHISPER_MODEL=base
